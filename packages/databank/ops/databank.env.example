# /etc/databank.env  (root:michael, mode 640). Never commit the real file.
DATABANK_ROOT=/mnt/databank
# Master key: generate on the PC with `databank keygen <file>`, copy here, and keep another
# copy in your password manager. It must NOT live on the vault itself.
DATABANK_KEY_FILE=/etc/databank.key
# At least 16 chars; generate with: openssl rand -hex 24
DATABANK_TOKEN=change-me
DATABANK_HOST=127.0.0.1
DATABANK_PORT=8790
# Embeddings are computed on the PC (Ollama). Fail-soft: search falls back to keywords.
OLLAMA_URL=http://100.80.203.59:11434
