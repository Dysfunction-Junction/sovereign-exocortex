{
  "name": "@exocortex/databank",
  "version": "1.0.0",
  "description": "Encrypted cold archive and searchable index (FTS5 + int8 vectors) for overflow memories and old media",
  "type": "module",
  "main": "databank.ts",
  "exports": {
    ".": "./databank.ts",
    "./server": "./server.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/crypto.test.ts test/blobstore.test.ts test/databank.test.ts test/server.test.ts",
    "cli": "tsx cli.ts",
    "bundle": "esbuild cli.ts --bundle --platform=node --format=esm --target=node24 --banner:js=\"import{createRequire as __cr}from\\\"node:module\\\";const require=__cr(import.meta.url);\" --outfile=dist/databank.mjs"
  },
  "dependencies": {
    "@exocortex/memory": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
