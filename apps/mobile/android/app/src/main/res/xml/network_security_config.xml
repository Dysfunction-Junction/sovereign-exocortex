<?xml version="1.0" encoding="utf-8"?>
<!--
  Release builds permit TLS only. Credentials (bearer tokens) and captured data must never travel in
  cleartext, so reach the home node through an https:// address (for example the Tailscale gateway).
  Android's <domain> element matches literal hostnames, not CIDR ranges, so there is no safe way to
  allow "any private IP" over HTTP; do not re-enable app-wide cleartext. USB / adb-reverse loopback
  development uses the debug overlay in app/src/debug/res/xml/network_security_config.xml.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
